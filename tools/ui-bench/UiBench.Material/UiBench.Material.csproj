<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.networkcontrol.uibench.material</ApplicationId>
    <ApplicationTitle>UI Bench Material</ApplicationTitle>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <RootNamespace>UiBench.Material</RootNamespace>
    <AssemblyName>UiBench.Material</AssemblyName>
    <!-- 只給 app 專案設定 RID，避免流向 UiBench.Common 等 Android 類庫。 -->
    <RuntimeIdentifiers Condition="'$(BenchAbi)' == 'arm64'">android-arm64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(BenchAbi)' == 'x64'">android-x64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(BenchAbi)' == ''">android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiBench.Common\UiBench.Common.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Android" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Material.Avalonia" Version="3.21.0" />
  </ItemGroup>
</Project>
