<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:NetworkControl.Android.ViewModels"
             xmlns:loc="using:NetworkControl.Android.Localization"
             x:Class="NetworkControl.Android.Views.PromptOverlay"
             x:DataType="vm:PromptViewModel">
  <!-- 應用內詢問：仿紅魔底部面板（與系統懸浮詢問窗 UI 及操作完全對齊） -->
  <Border Classes="scrim">
    <Border VerticalAlignment="Bottom"
            CornerRadius="22,22,0,0"
            Padding="22,20,22,12"
            Background="{atom:SharedTokenResource ColorBgElevated}"
            BoxShadow="0 -4 24 0 #33000000">
      <StackPanel Spacing="12">
        <!-- 頂部應用識別列：圓角圖示 + 應用名與包名 + 網路膠囊標籤 -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Width="46" Height="46" CornerRadius="12" ClipToBounds="True"
                  Background="{atom:SharedTokenResource ColorFillTertiary}">
            <Image Width="46" Height="46" Source="{Binding Icon}" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding AppDisplayName}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="caption" Text="{Binding PackageName}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="999" Padding="10,4"
                  Background="{atom:SharedTokenResource ColorPrimaryBg}"
                  BorderBrush="{atom:SharedTokenResource ColorPrimaryBorder}"
                  BorderThickness="1">
            <TextBlock FontSize="12" FontWeight="Bold"
                       Foreground="{atom:SharedTokenResource ColorPrimary}"
                       Text="{Binding NetworkBadgeText}" />
          </Border>
        </Grid>

        <!-- 主詢問文案 -->
        <TextBlock FontSize="16" LineHeight="22" TextWrapping="Wrap" Text="{Binding RequestMessage}" />

        <!-- 目標詳情卡片（可選） -->
        <Border IsVisible="{Binding ShowDetails}" CornerRadius="10" Padding="12,8"
                Background="{atom:SharedTokenResource ColorFillTertiary}">
          <TextBlock FontSize="12.5" Classes="secondary" TextWrapping="Wrap">
            <Run Text="{loc:PromptLangResource Target}" />
            <Run Text="：" />
            <Run Text="{Binding DetailText}" />
          </TextBlock>
        </Border>

        <atom:Alert Type="Error" IsShowIcon="True" Message="{loc:PromptLangResource TamperHint}" IsVisible="{Binding IsTamper}" />

        <!-- 「不再提示」開關 + 排隊 / 稍後 -->
        <Grid ColumnDefinitions="*,Auto">
          <atom:CheckBox IsVisible="{Binding ShowDontAskAgain}"
                         IsChecked="{Binding DontAskAgain}"
                         Content="{loc:PromptLangResource DontAskAgain}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding QueueText}" />
            <atom:Button ButtonType="Text" Command="{Binding LaterCommand}" Content="{loc:PromptLangResource Later}" />
          </StackPanel>
        </Grid>

        <!-- 橫向等寬操作列：禁止 | 允許 | 僅本次 | 限時（出現 1 秒後可點） -->
        <UniformGrid Rows="1" IsEnabled="{Binding IsInteractive}">
          <atom:Button ButtonType="Text" IsDanger="True" HorizontalAlignment="Stretch" Height="48"
                       FontSize="16" FontWeight="Bold"
                       Command="{Binding BlockCommand}" IsLoading="{Binding IsBusy}"
                       Content="{loc:PromptLangResource Deny}" />
          <atom:Button ButtonType="Text" HorizontalAlignment="Stretch" Height="48"
                       FontSize="16" FontWeight="Bold"
                       Command="{Binding AllowCommand}" IsLoading="{Binding IsBusy}"
                       Content="{loc:CommonLangResource Allow}" />
          <atom:Button ButtonType="Text" HorizontalAlignment="Stretch" Height="48"
                       FontSize="16" FontWeight="Bold"
                       Command="{Binding AllowOnceCommand}" IsLoading="{Binding IsBusy}"
                       Content="{loc:PromptLangResource Once}" />
          <atom:Button ButtonType="Text" HorizontalAlignment="Stretch" Height="48"
                       FontSize="15" FontWeight="Bold"
                       IsVisible="{Binding ShowTimedOption}"
                       Command="{Binding AllowTimedCommand}" IsLoading="{Binding IsBusy}"
                       Content="{Binding TimedLabel}" />
        </UniformGrid>
      </StackPanel>
    </Border>
  </Border>
</UserControl>
