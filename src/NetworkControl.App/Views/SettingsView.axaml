<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:NetworkControl.App.ViewModels"
             xmlns:loc="using:NetworkControl.App.Localization"
             x:Class="NetworkControl.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Resources>
    <DataTemplate x:Key="ChoiceTemplate" x:DataType="vm:Choice">
      <TextBlock Text="{Binding Title}" />
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel Spacing="2">
        <TextBlock Classes="page-title" Text="{loc:SettingsLangResource Title}" />
        <TextBlock Classes="secondary" Text="{loc:SettingsLangResource Subtitle}" TextWrapping="Wrap" />
      </StackPanel>

      <atom:Alert Type="Error" IsShowIcon="True" IsClosable="True" Message="{Binding ErrorMessage}"
                  IsVisible="{Binding ErrorMessage, Converter={x:Static vm:Converters.HasText}}" />

      <!-- 界面設置：保存在本機，即時生效 -->
      <atom:Card Header="{loc:SettingsLangResource SectionInterface}">
        <Grid ColumnDefinitions="280,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{loc:SettingsLangResource Language}" />
          <atom:ComboBox Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                         ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" ItemTemplate="{StaticResource ChoiceTemplate}" />

          <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{loc:SettingsLangResource Theme}" />
          <atom:Segmented Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" SelectedIndex="{Binding ThemeIndex}">
            <atom:SegmentedItem Content="{loc:SettingsLangResource ThemeFollowSystem}" />
            <atom:SegmentedItem Content="{loc:SettingsLangResource ThemeLight}" />
            <atom:SegmentedItem Content="{loc:SettingsLangResource ThemeDark}" />
          </atom:Segmented>

          <TextBlock Grid.Row="2" VerticalAlignment="Center" IsVisible="{Binding IsAutoStartSupported}" Text="{loc:SettingsLangResource LaunchAtLogin}" />
          <atom:ToggleSwitch Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsAutoStartSupported}" HorizontalAlignment="Left" IsChecked="{Binding LaunchAtLogin}" />
        </Grid>
      </atom:Card>

      <!-- 服務設置：保存在核心服務中，對本機所有用戶生效 -->
      <StackPanel Spacing="16" IsEnabled="{Binding IsConnected}">
        <TextBlock Classes="secondary" Text="{loc:SettingsLangResource ServiceSettingsHint}" TextWrapping="Wrap" />

        <atom:Card Header="{loc:SettingsLangResource SectionPrompt}">
          <Grid ColumnDefinitions="280,*" RowDefinitions="Auto,Auto" RowSpacing="14">
            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{loc:SettingsLangResource PromptTimeout}" />
            <atom:NumericUpDown Grid.Row="0" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                Minimum="5" Maximum="300" Increment="5" FormatString="0" Value="{Binding PromptTimeoutSeconds}" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{loc:SettingsLangResource DefaultAction}" />
            <atom:ComboBox Grid.Row="1" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                           ItemsSource="{Binding DefaultActions}" SelectedItem="{Binding DefaultAction}" ItemTemplate="{StaticResource ChoiceTemplate}" />
          </Grid>
        </atom:Card>

        <atom:Card Header="{loc:SettingsLangResource SectionSafety}">
          <Grid ColumnDefinitions="280,*" RowDefinitions="Auto,Auto" RowSpacing="14">
            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{loc:SettingsLangResource FailPolicy}" />
            <atom:ComboBox Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                           ItemsSource="{Binding FailPolicies}" SelectedItem="{Binding FailPolicy}" ItemTemplate="{StaticResource ChoiceTemplate}" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{loc:SettingsLangResource AllowIcmp}" />
            <atom:ToggleSwitch Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" IsChecked="{Binding AllowIcmp}" />
          </Grid>
        </atom:Card>

        <atom:Card Header="{loc:SettingsLangResource SectionData}">
          <Grid ColumnDefinitions="280,*">
            <TextBlock VerticalAlignment="Center" Text="{loc:SettingsLangResource LogRetention}" />
            <atom:NumericUpDown Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                Minimum="1" Maximum="3650" Increment="1" FormatString="0" Value="{Binding LogRetentionDays}" />
          </Grid>
        </atom:Card>

        <atom:Button ButtonType="Primary" HorizontalAlignment="Left" Command="{Binding SaveCommand}" Content="{loc:CommonLangResource Save}" />
      </StackPanel>

      <!-- 規則導出 / 導入 / 從備份恢復（FR-SET-03 / 04） -->
      <atom:Card Header="{loc:SettingsLangResource SectionTransfer}" IsEnabled="{Binding IsConnected}">
        <StackPanel Spacing="14">
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:SettingsLangResource TransferHint}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <atom:Button Icon="{antdicons:AntDesignIconProvider Kind=ExportOutlined}"
                         Command="{Binding ExportRulesCommand}" Content="{loc:SettingsLangResource ExportRules}" />
            <atom:Button Icon="{antdicons:AntDesignIconProvider Kind=ImportOutlined}"
                         Command="{Binding ImportRulesCommand}" Content="{loc:SettingsLangResource ImportRules}" />
          </StackPanel>
          <Grid ColumnDefinitions="280,*">
            <TextBlock VerticalAlignment="Center" Text="{loc:SettingsLangResource Backups}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <atom:ComboBox Width="300" IsVisible="{Binding HasBackups}" ItemsSource="{Binding Backups}"
                             SelectedItem="{Binding SelectedBackup}" ItemTemplate="{StaticResource ChoiceTemplate}" />
              <atom:Button IsVisible="{Binding HasBackups}" Icon="{antdicons:AntDesignIconProvider Kind=HistoryOutlined}"
                           Command="{Binding RestoreBackupCommand}" Content="{loc:SettingsLangResource RestoreBackup}" />
              <TextBlock Classes="secondary" VerticalAlignment="Center" IsVisible="{Binding !HasBackups}" Text="{loc:SettingsLangResource NoBackups}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </atom:Card>

      <!-- 診斷：不依賴服務連接，服務異常時也能導出 -->
      <atom:Card Header="{loc:SettingsLangResource SectionDiagnostics}">
        <StackPanel Spacing="12">
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:SettingsLangResource DiagnosticsHint}" />
          <atom:CheckBox IsChecked="{Binding DiagnosticsIncludeConfiguration}" Content="{loc:SettingsLangResource DiagnosticsIncludeConfiguration}" />
          <atom:CheckBox IsChecked="{Binding DiagnosticsIncludeActivity}" Content="{loc:SettingsLangResource DiagnosticsIncludeActivity}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <atom:Button ButtonType="Primary" Command="{Binding ExportDiagnosticsCommand}" IsLoading="{Binding IsExportingDiagnostics}"
                         Content="{loc:SettingsLangResource DiagnosticsExport}" />
            <atom:Button Command="{Binding OpenLogFolderCommand}" Content="{loc:SettingsLangResource DiagnosticsOpenLogFolder}" />
          </StackPanel>
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:SettingsLangResource DiagnosticsCommandLineHint}" />
        </StackPanel>
      </atom:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
