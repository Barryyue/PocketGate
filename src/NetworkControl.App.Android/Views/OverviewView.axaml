<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:controls="using:NetworkControl.Android.Controls"
             xmlns:vm="using:NetworkControl.Android.ViewModels"
             xmlns:loc="using:NetworkControl.Android.Localization"
             x:Class="NetworkControl.Android.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
  <Panel>
    <ScrollViewer>
      <StackPanel Margin="16,16,16,96" Spacing="14">
      <TextBlock Classes="page-title" Text="{loc:ShellLangResource AppTitle}" />

      <!-- 總覽頂部背景更新下載進度條 / 安裝就緒橫幅 -->
      <atom:Card IsVisible="{Binding ShowUpdateBanner}">
        <StackPanel Spacing="8">
          <StackPanel Spacing="6" IsVisible="{Binding UpdateDownloading}">
            <TextBlock Classes="title" Text="{Binding UpdateDownloadingText}" />
            <atom:ProgressBar Value="{Binding UpdateDownloadProgress}" Minimum="0" Maximum="100" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding UpdateReady}">
            <TextBlock Classes="title" VerticalAlignment="Center" Text="{Binding UpdateReadyText}" TextWrapping="Wrap" />
            <atom:Button Grid.Column="1" ButtonType="Primary" Command="{Binding InstallUpdateCommand}" Content="{loc:OverviewLangResource UpdateInstallNow}" />
          </Grid>
        </StackPanel>
      </atom:Card>

      <!-- 權限待辦輕量橫幅 -->
      <atom:Card IsVisible="{Binding ShowPermissionBanner}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding PermissionBannerTitle}" TextWrapping="Wrap" />
          <atom:Button Grid.Column="1" ButtonType="Primary" Command="{Binding OpenPermissionGuideCommand}" Content="{loc:OverviewLangResource PermBannerAction}" />
          <atom:Button Grid.Column="2" ButtonType="Text" Icon="{antdicons:AntDesignIconProvider Kind=CloseOutlined}" Command="{Binding DismissPermissionBannerCommand}" />
        </Grid>
      </atom:Card>

      <!-- 旗艦保護開關卡片 -->
      <atom:Card>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Classes="hero-badge" VerticalAlignment="Center">
            <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=SafetyCertificateOutlined}"
                                Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="title" Text="{Binding StatusText}"
                         Classes.success="{Binding StatusColor, Converter={x:Static vm:Converters.IsEqual}, ConverterParameter=success}"
                         Classes.warning="{Binding StatusColor, Converter={x:Static vm:Converters.IsEqual}, ConverterParameter=warning}"
                         Classes.error="{Binding StatusColor, Converter={x:Static vm:Converters.IsEqual}, ConverterParameter=error}" />
              <atom:Tag Text="{Binding ExitBadgeText}" />
            </StackPanel>
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding StatusHint}" />
          </StackPanel>
          <atom:ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsChecked="{Binding IsProtectionOn}" IsEnabled="{Binding !IsBusy}" />
        </Grid>
      </atom:Card>

      <!-- 36 點平滑即時網速波形圖 -->
      <atom:Card Header="{loc:OverviewLangResource CurrentSpeed}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,*">
            <TextBlock Classes="title" Text="{Binding CurrentDownloadSpeed}" />
            <TextBlock Grid.Column="1" Classes="secondary" HorizontalAlignment="Right" Text="{Binding CurrentUploadSpeed}" />
          </Grid>
          <controls:SpeedChartControl Height="76"
                                      DownloadHistory="{Binding DownloadHistory}"
                                      UploadHistory="{Binding UploadHistory}" />
        </StackPanel>
      </atom:Card>

      <atom:Alert Type="Warning" IsShowIcon="True" Message="{loc:OverviewLangResource BlockAllActive}" IsVisible="{Binding IsBlockAll}" />
      <atom:Alert Type="Warning" IsShowIcon="True" Message="{Binding PrivateDnsWarningText}" IsVisible="{Binding HasPrivateDns}" />
      <atom:Alert Type="Error" IsShowIcon="True" Message="{Binding ProfileError}" IsVisible="{Binding HasProfileError}" />
      <atom:Button IsVisible="{Binding ShowSwitchToDirect}" HorizontalAlignment="Stretch"
                   Command="{Binding SwitchToDirectCommand}" Content="{loc:OverviewLangResource SwitchToDirect}" />

      <atom:Card IsVisible="{Binding HasQuietPeriod}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding QuietPeriodText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <atom:Button Grid.Column="1" Command="{Binding DismissQuietPeriodCommand}" Content="{loc:OverviewLangResource Dismiss}" />
        </Grid>
      </atom:Card>

      <atom:Card IsVisible="{Binding NotificationsOff}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Classes="secondary" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:OverviewLangResource NotificationsOff}" />
          <atom:Button Grid.Column="1" Command="{Binding EnableNotificationsCommand}" Content="{loc:OverviewLangResource EnableNotifications}" />
        </Grid>
      </atom:Card>

      <!-- 模式 -->
      <atom:Card Header="{loc:OverviewLangResource Mode}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="8" IsVisible="{Binding ShowProfiles}">
            <TextBlock Classes="secondary" Text="{loc:OverviewLangResource Profiles}" />
            <atom:ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Stretch">
              <atom:ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileChoice">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </atom:ComboBox.ItemTemplate>
            </atom:ComboBox>
          </StackPanel>
          <atom:Segmented SelectedIndex="{Binding ModeIndex}" IsEnabled="{Binding !IsBlockAll}" HorizontalAlignment="Stretch" IsExpanding="True">
            <atom:SegmentedItem Content="{loc:CommonLangResource ModeAsk}" />
            <atom:SegmentedItem Content="{loc:CommonLangResource ModeWhitelist}" />
            <atom:SegmentedItem Content="{loc:CommonLangResource ModeBlacklist}" />
          </atom:Segmented>
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding ModeDescriptionText}" />
          <atom:Button ButtonType="Primary" IsDanger="True" HorizontalAlignment="Stretch" IsVisible="{Binding !IsBlockAll}"
                       Icon="{antdicons:AntDesignIconProvider Kind=StopOutlined}"
                       Command="{Binding ToggleBlockAllCommand}" Content="{loc:OverviewLangResource BlockAll}" />
          <atom:Button ButtonType="Primary" HorizontalAlignment="Stretch" IsVisible="{Binding IsBlockAll}"
                       Icon="{antdicons:AntDesignIconProvider Kind=PoweroffOutlined}"
                       Command="{Binding ToggleBlockAllCommand}" Content="{loc:OverviewLangResource Restore}" />
        </StackPanel>
      </atom:Card>

      <!-- 3×2 Bento 統計與快捷操作網格（對齊 Kotlin 版） -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <atom:Card>
          <atom:Statistic Header="{loc:OverviewLangResource BlockedToday}" Value="{Binding BlockedToday}" />
        </atom:Card>
        <atom:Card Grid.Column="1">
          <StackPanel Spacing="6">
            <atom:Statistic Header="{loc:OverviewLangResource PendingPrompts}" Value="{Binding PendingPrompts}" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasPendingPrompts}">
              <atom:Button SizeType="Small" Command="{Binding ShowPromptCommand}" Content="{loc:OverviewLangResource ShowPrompt}" />
              <atom:Button SizeType="Small" ButtonType="Primary" Command="{Binding OpenBatchDialogCommand}" Content="{loc:OverviewLangResource BatchSelectAll}" />
            </StackPanel>
          </StackPanel>
        </atom:Card>
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <atom:Card>
          <StackPanel Spacing="4">
            <TextBlock Classes="caption" Text="{loc:OverviewLangResource UsageToday}" />
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding TrafficTileSummary}" TextWrapping="Wrap" />
          </StackPanel>
        </atom:Card>
        <atom:Card Grid.Column="1">
          <StackPanel Spacing="4">
            <atom:Statistic Header="{loc:OverviewLangResource RulesTile}" Value="{Binding ActiveRuleCount}" />
            <TextBlock Classes="caption" Text="{Binding ActiveProfileName}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </atom:Card>
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <atom:Card>
          <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="{loc:OverviewLangResource FocusMode}" />
            <TextBlock Classes="title" Text="{Binding FocusStatusText}" />
            <atom:Button SizeType="Small" IsVisible="{Binding !IsFocusActive}" Command="{Binding OpenFocusDialogCommand}" Content="{loc:OverviewLangResource FocusMode}" HorizontalAlignment="Left" />
          </StackPanel>
        </atom:Card>
        <atom:Card Grid.Column="1">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="caption" Text="{loc:OverviewLangResource DoNotDisturb}" />
              <TextBlock Classes="secondary" FontSize="12" Text="1h" />
            </StackPanel>
            <atom:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsDoNotDisturb}" />
          </Grid>
        </atom:Card>
      </Grid>

      <!-- 專注模式運行中操作卡 -->
      <atom:Card IsVisible="{Binding IsFocusActive}" Header="{loc:OverviewLangResource FocusMode}">
        <StackPanel Spacing="10">
          <TextBlock Classes="title" Text="{Binding FocusStatusText}" />
          <UniformGrid Columns="3">
            <atom:Button HorizontalAlignment="Stretch" Margin="0,0,4,0" Command="{Binding ExtendFocusCommand}" Content="{loc:OverviewLangResource FocusExtend}" />
            <atom:Button HorizontalAlignment="Stretch" Margin="2,0" IsDanger="True" Command="{Binding StopFocusCommand}" Content="{loc:OverviewLangResource FocusStop}" />
            <atom:Button HorizontalAlignment="Stretch" Margin="4,0,0,0" ButtonType="Primary" Command="{Binding SaveFocusAsProfileCommand}" Content="{loc:OverviewLangResource FocusSaveProfile}" />
          </UniformGrid>
        </StackPanel>
      </atom:Card>

      <!-- 今日用量（FR-STA-01） -->
      <atom:Card Header="{loc:OverviewLangResource UsageToday}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="12" IsVisible="{Binding !HasTrafficAccess}">
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:OverviewLangResource UsageAccessNeeded}" />
            <atom:Button HorizontalAlignment="Left" Command="{Binding GrantUsageAccessCommand}" Content="{loc:OverviewLangResource GrantUsageAccess}" />
          </StackPanel>
          <StackPanel Spacing="12" IsVisible="{Binding HasTrafficAccess}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="2">
                <TextBlock Classes="caption" Text="{loc:OverviewLangResource Download}" />
                <TextBlock Classes="title" Text="{Binding DownloadToday}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="caption" Text="{loc:OverviewLangResource Upload}" />
                <TextBlock Classes="title" Text="{Binding UploadToday}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding TopUsage}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UsageRow">
                  <StackPanel Spacing="4" Margin="0,4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Bytes}" Margin="12,0,0,0" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="4" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="secondary" Text="{loc:OverviewLangResource NoUsage}" IsVisible="{Binding HasNoUsage}" />
          </StackPanel>
        </StackPanel>
      </atom:Card>

      <atom:Alert Type="Info" IsShowIcon="True" Message="{Binding SkippedRulesText}" IsVisible="{Binding HasSkippedRules}" />
      </StackPanel>
    </ScrollViewer>

    <!-- 專注模式啟動彈窗 -->
    <Border Classes="scrim" IsVisible="{Binding ShowFocusDialog}">
      <atom:Card VerticalAlignment="Center" Margin="18" Header="{loc:OverviewLangResource FocusStartTitle}">
        <StackPanel Spacing="12">
          <TextBlock Classes="secondary" Text="{loc:OverviewLangResource FocusDuration}" />
          <atom:Segmented SelectedIndex="{Binding FocusDurationIndex}" HorizontalAlignment="Stretch" IsExpanding="True">
            <atom:SegmentedItem Content="15m" />
            <atom:SegmentedItem Content="30m" />
            <atom:SegmentedItem Content="60m" />
            <atom:SegmentedItem Content="120m" />
          </atom:Segmented>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{loc:OverviewLangResource FocusAppsHint}" />
          <atom:LineEdit Text="{Binding FocusAppSearch}" PlaceholderText="{loc:AppsLangResource Search}" />
          <ScrollViewer MaxHeight="220">
            <ItemsControl ItemsSource="{Binding FocusApps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FocusAppOption">
                  <atom:CheckBox IsVisible="{Binding IsVisible}" IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="0,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <atom:Button HorizontalAlignment="Stretch" Command="{Binding CloseFocusDialogCommand}" Content="{loc:CommonLangResource Cancel}" />
            <atom:Button Grid.Column="1" ButtonType="Primary" HorizontalAlignment="Stretch" Command="{Binding StartFocusCommand}" Content="{loc:OverviewLangResource FocusMode}" />
          </Grid>
        </StackPanel>
      </atom:Card>
    </Border>

    <!-- 批量詢問處理彈窗 -->
    <Border Classes="scrim" IsVisible="{Binding ShowBatchDialog}">
      <atom:Card VerticalAlignment="Center" Margin="18" Header="{loc:OverviewLangResource PendingPrompts}">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <atom:Button SizeType="Small" Command="{Binding BatchSelectAllCommand}" Content="{loc:OverviewLangResource BatchSelectAll}" />
            <atom:Button SizeType="Small" Command="{Binding BatchClearAllCommand}" Content="{loc:OverviewLangResource BatchClear}" />
          </StackPanel>
          <atom:Segmented SelectedIndex="{Binding BatchLifetimeIndex}" HorizontalAlignment="Stretch" IsExpanding="True">
            <atom:SegmentedItem Content="{loc:PromptLangResource UntilRestart}" />
            <atom:SegmentedItem Content="{loc:PromptLangResource Forever}" />
            <atom:SegmentedItem Content="{loc:PromptLangResource OneHour}" />
          </atom:Segmented>
          <ScrollViewer MaxHeight="220">
            <ItemsControl ItemsSource="{Binding BatchPrompts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BatchPromptOption">
                  <atom:CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="0,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <atom:Button HorizontalAlignment="Stretch" Command="{Binding CloseBatchDialogCommand}" Content="{loc:CommonLangResource Cancel}" />
            <atom:Button Grid.Column="1" ButtonType="Primary" IsDanger="True" HorizontalAlignment="Stretch" Command="{Binding BatchDenyCommand}" Content="{loc:CommonLangResource Block}" />
            <atom:Button Grid.Column="2" ButtonType="Primary" HorizontalAlignment="Stretch" Command="{Binding BatchAllowCommand}" Content="{loc:CommonLangResource Allow}" />
          </Grid>
        </StackPanel>
      </atom:Card>
    </Border>
  </Panel>
</UserControl>
