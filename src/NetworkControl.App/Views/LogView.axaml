<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:NetworkControl.App.ViewModels"
             xmlns:loc="using:NetworkControl.App.Localization"
             x:Class="NetworkControl.App.Views.LogView"
             x:DataType="vm:LogViewModel"
             x:Name="Root">

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,16">
      <StackPanel Spacing="2">
        <TextBlock Classes="page-title" Text="{loc:LogLangResource Title}" />
        <TextBlock Classes="secondary" Text="{loc:LogLangResource Subtitle}" />
      </StackPanel>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <atom:ToggleSwitch IsChecked="{Binding IsLive}" />
            <TextBlock VerticalAlignment="Center" Text="{loc:LogLangResource Live}" />
          </StackPanel>
          <atom:Button Icon="{antdicons:AntDesignIconProvider Kind=ReloadOutlined}"
                       Command="{Binding QueryCommand}" Content="{loc:CommonLangResource Refresh}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <atom:SearchEdit Width="320" Text="{Binding Keyword}" PlaceholderText="{loc:LogLangResource SearchPlaceholder}"
                           SearchRequested="OnSearchRequested" />
          <atom:Segmented SelectedIndex="{Binding ActionFilter}">
            <atom:SegmentedItem Content="{loc:CommonLangResource All}" />
            <atom:SegmentedItem Content="{loc:CommonLangResource Allow}" />
            <atom:SegmentedItem Content="{loc:CommonLangResource Deny}" />
          </atom:Segmented>
        </StackPanel>
      </DockPanel>
      <atom:Alert Type="Error" IsShowIcon="True" IsClosable="True" Message="{Binding ErrorMessage}"
                  IsVisible="{Binding ErrorMessage, Converter={x:Static vm:Converters.HasText}}" />
    </StackPanel>

    <Panel>
      <atom:Empty IsVisible="{Binding IsEmpty}" Description="{loc:LogLangResource Empty}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
      <atom:DataGrid ItemsSource="{Binding ItemsSource}" IsVisible="{Binding !IsEmpty}" IsReadOnly="True"
                     CanUserResizeColumns="True">
        <atom:DataGrid.Columns>
          <atom:DataGridTextColumn x:DataType="vm:LogItemViewModel" Header="{loc:LogLangResource ColumnTime}" Binding="{Binding TimeText}" Width="170" />
          <atom:DataGridTemplateColumn Header="{loc:LogLangResource ColumnApp}" Width="2*">
            <atom:DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:LogItemViewModel">
                <TextBlock Text="{Binding AppName}" ToolTip.Tip="{Binding AppPathValue}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DataTemplate>
            </atom:DataGridTemplateColumn.CellTemplate>
          </atom:DataGridTemplateColumn>
          <atom:DataGridTextColumn x:DataType="vm:LogItemViewModel" Header="{loc:LogLangResource ColumnDirection}" Binding="{Binding DirectionText}" Width="80" />
          <atom:DataGridTextColumn x:DataType="vm:LogItemViewModel" Header="{loc:LogLangResource ColumnProtocol}" Binding="{Binding ProtocolText}" Width="80" />
          <atom:DataGridTextColumn x:DataType="vm:LogItemViewModel" Header="{loc:LogLangResource ColumnRemote}" Binding="{Binding Remote}" Width="170" />
          <atom:DataGridTextColumn x:DataType="vm:LogItemViewModel" Header="{loc:LogLangResource ColumnHost}" Binding="{Binding Host}" Width="2*" />
          <atom:DataGridTemplateColumn Header="{loc:LogLangResource ColumnVerdict}" Width="88">
            <atom:DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:LogItemViewModel">
                <atom:Tag Text="{Binding VerdictText}" TagColor="{Binding VerdictColor}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              </DataTemplate>
            </atom:DataGridTemplateColumn.CellTemplate>
          </atom:DataGridTemplateColumn>
          <atom:DataGridTextColumn x:DataType="vm:LogItemViewModel" Header="{loc:LogLangResource ColumnReason}" Binding="{Binding ReasonText}" Width="110" />
          <atom:DataGridTextColumn x:DataType="vm:LogItemViewModel" Header="{loc:LogLangResource ColumnCount}" Binding="{Binding Count}" Width="72" />
          <atom:DataGridTemplateColumn Header="{loc:LogLangResource ColumnOperations}" Width="150">
            <atom:DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:LogItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <atom:Button ButtonType="Link" SizeType="Small" Content="{loc:LogLangResource Details}"
                               Command="{Binding #Root.((vm:LogViewModel)DataContext).ShowDetailsCommand}" CommandParameter="{Binding}" />
                  <atom:Button ButtonType="Link" SizeType="Small"
                               Content="{loc:LogLangResource CreateRule}"
                               Command="{Binding #Root.((vm:LogViewModel)DataContext).CreateRuleCommand}" CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </atom:DataGridTemplateColumn.CellTemplate>
          </atom:DataGridTemplateColumn>
        </atom:DataGrid.Columns>
      </atom:DataGrid>
    </Panel>
  </DockPanel>
</UserControl>
