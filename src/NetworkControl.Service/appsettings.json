{
  "NetworkControl": {
    "Service": {
      "Engine": "Auto",
      "IpcEndpoint": null,
      "TreatAllClientsAsAdmin": true
    },
    "Storage": {
      "DataDirectory": null
    },
    "Dns": {
      "MaxAddresses": 100000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Grpc": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
