      </segment>
    </unit>
    <unit id="StatusStarting">
      <segment>
        <source>Starting protection…</source>
        <target state="translated">正在开启保护…</target>
      </segment>
    </unit>
    <unit id="Upload">
      <segment>
        <source>Upload</source>
        <target state="translated">上传</target>
      </segment>
    </unit>
    <unit id="UsageAccessNeeded">
      <segment>
        <source>Allow usage access so NetworkControl can show how much data each app uses.</source>
        <target state="translated">允许“使用情况访问权限”后，即可查看每个应用的数据用量。</target>
      </segment>
    </unit>
    <unit id="UsageToday">
      <segment>
        <source>Data used today</source>
        <target state="translated">今日用量</target>
      </segment>
    </unit>
  </file>
