<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:NetworkControl.Android.ViewModels"
             xmlns:loc="using:NetworkControl.Android.Localization"
             x:Class="NetworkControl.Android.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <Grid>
    <ScrollViewer>
    <StackPanel Margin="16" Spacing="16">
      <TextBlock Classes="page-title" Text="{loc:ShellLangResource NavSettings}" />

      <atom:Card Header="{loc:SettingsLangResource Language}">
        <atom:Segmented SelectedIndex="{Binding LanguageIndex}" HorizontalAlignment="Stretch" IsExpanding="True">
          <atom:SegmentedItem Content="{loc:SettingsLangResource FollowSystem}" />
          <atom:SegmentedItem Content="繁體" />
          <atom:SegmentedItem Content="简体" />
          <atom:SegmentedItem Content="EN" />
        </atom:Segmented>
      </atom:Card>

      <atom:Card Header="{loc:SettingsLangResource Theme}">
        <atom:Segmented SelectedIndex="{Binding ThemeIndex}" HorizontalAlignment="Stretch" IsExpanding="True">
          <atom:SegmentedItem Content="{loc:SettingsLangResource FollowSystem}" />
          <atom:SegmentedItem Content="{loc:SettingsLangResource ThemeLight}" />
          <atom:SegmentedItem Content="{loc:SettingsLangResource ThemeDark}" />
        </atom:Segmented>
      </atom:Card>

      <atom:Card Header="{loc:SettingsLangResource Prompts}">
        <StackPanel Spacing="12">
          <TextBlock Classes="secondary" Text="{loc:SettingsLangResource PromptTimeout}" />
          <atom:Segmented SelectedIndex="{Binding TimeoutIndex}" HorizontalAlignment="Stretch" IsExpanding="True">
            <atom:SegmentedItem Content="{Binding Timeout15}" />
            <atom:SegmentedItem Content="{Binding Timeout30}" />
            <atom:SegmentedItem Content="{Binding Timeout60}" />
            <atom:SegmentedItem Content="{Binding Timeout120}" />
          </atom:Segmented>
          <TextBlock Classes="secondary" Text="{loc:SettingsLangResource DefaultAction}" />
          <atom:Segmented SelectedIndex="{Binding DefaultActionIndex}" HorizontalAlignment="Stretch" IsExpanding="True">
            <atom:SegmentedItem Content="{loc:CommonLangResource Block}" />
            <atom:SegmentedItem Content="{loc:CommonLangResource Allow}" />
          </atom:Segmented>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel>
              <TextBlock Text="{loc:SettingsLangResource Notifications}" />
              <TextBlock Classes="caption" Text="{Binding NotificationsText}" />
            </StackPanel>
            <atom:Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding OpenNotificationSettingsCommand}" Content="{loc:SettingsLangResource Open}" />
          </Grid>
        </StackPanel>
      </atom:Card>

      <atom:Card Header="{loc:SettingsLangResource AlwaysOn}">
        <StackPanel Spacing="12">
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:SettingsLangResource AlwaysOnHint}" />
          <atom:Button HorizontalAlignment="Left" Command="{Binding OpenVpnSettingsCommand}" Content="{loc:SettingsLangResource Open}" />
        </StackPanel>
      </atom:Card>

      <atom:Card Header="{loc:SettingsLangResource Traffic}">
        <StackPanel Spacing="12">
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:SettingsLangResource TrafficHint}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Center" Text="{Binding TrafficAccessText}" />
            <atom:Button Grid.Column="1" Command="{Binding OpenTrafficSettingsCommand}" Content="{loc:SettingsLangResource Open}" />
          </Grid>
        </StackPanel>
      </atom:Card>

      <atom:Card Header="{loc:SettingsLangResource Profiles}">
        <StackPanel Spacing="12">
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:SettingsLangResource ProfileHint}" />
          <atom:ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Stretch">
            <atom:ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <atom:Tag Grid.Column="1" IsVisible="{Binding IsActive}" Text="{loc:SettingsLangResource ProfileCurrent}" />
                </Grid>
              </DataTemplate>
            </atom:ComboBox.ItemTemplate>
          </atom:ComboBox>
          <atom:Alert Type="Error" IsShowIcon="True" Message="{Binding ProfileError}" IsVisible="{Binding HasProfileError}" />
          <atom:LineEdit Text="{Binding ProfileName}" PlaceholderText="{loc:SettingsLangResource ProfileNamePlaceholder}" />
          <TextBlock Classes="secondary" Text="{loc:SettingsLangResource ProfileMode}" />
          <atom:Segmented SelectedIndex="{Binding ProfileModeIndex}" HorizontalAlignment="Stretch" IsExpanding="True">
            <atom:SegmentedItem Content="{loc:CommonLangResource ModeAsk}" />
            <atom:SegmentedItem Content="{loc:CommonLangResource ModeWhitelist}" />
            <atom:SegmentedItem Content="{loc:CommonLangResource ModeBlacklist}" />
          </atom:Segmented>

          <!-- 自動切換（M3-04）：目前網路符合條件時切換到這個配置文件 -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel>
              <TextBlock Text="{loc:SettingsLangResource AutoSwitch}" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{loc:SettingsLangResource AutoSwitchHint}" />
            </StackPanel>
            <atom:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AutoSwitchEnabled}" />
          </Grid>
          <StackPanel Spacing="8" IsVisible="{Binding AutoSwitchEnabled}">
            <TextBlock Classes="secondary" Text="{loc:SettingsLangResource NetworkKind}" />
            <atom:Segmented SelectedIndex="{Binding AutoKindIndex}" HorizontalAlignment="Stretch" IsExpanding="True">
              <atom:SegmentedItem Content="{loc:SettingsLangResource NetworkKindAny}" />
              <atom:SegmentedItem Content="{loc:SettingsLangResource NetworkKindWired}" />
              <atom:SegmentedItem Content="{loc:SettingsLangResource NetworkKindWifi}" />
              <atom:SegmentedItem Content="{loc:SettingsLangResource NetworkKindCellular}" />
            </atom:Segmented>
            <TextBlock Classes="secondary" Text="{loc:SettingsLangResource NetworkSsids}" />
            <atom:LineEdit Text="{Binding AutoSsids}" PlaceholderText="{loc:SettingsLangResource NetworkSsidsPlaceholder}" />
            <atom:Button HorizontalAlignment="Left" Command="{Binding UseCurrentWifiCommand}" Content="{loc:SettingsLangResource UseCurrentWifi}" />
          </StackPanel>

          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <atom:Button HorizontalAlignment="Stretch" Command="{Binding AddProfileCommand}" Content="{loc:SettingsLangResource ProfileAdd}" />
            <atom:Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{Binding SaveProfileCommand}" Content="{loc:SettingsLangResource ProfileSave}" />
            <atom:Button Grid.Row="1" HorizontalAlignment="Stretch" IsEnabled="{Binding CanActivateSelected}"
                         Command="{Binding ActivateProfileCommand}" Content="{loc:SettingsLangResource ProfileActivate}" />
            <atom:PopupConfirm Grid.Row="1" Grid.Column="1" Title="{loc:SettingsLangResource ProfileDeleteConfirmTitle}"
                               ConfirmContent="{loc:SettingsLangResource ProfileDeleteConfirmContent}"
                               OkButtonType="Primary" Confirmed="OnDeleteProfileConfirmed">
              <atom:Button HorizontalAlignment="Stretch" IsDanger="True" IsEnabled="{Binding CanDeleteSelected}"
                           Content="{loc:SettingsLangResource ProfileDelete}" />
            </atom:PopupConfirm>
          </Grid>
        </StackPanel>
      </atom:Card>

      <atom:Card Header="{loc:SettingsLangResource Battery}">
        <StackPanel Spacing="12">
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:SettingsLangResource BatteryHint}" />
          <atom:Button HorizontalAlignment="Left" Command="{Binding OpenBatterySettingsCommand}" Content="{loc:SettingsLangResource Open}" />
        </StackPanel>
      </atom:Card>

      <atom:Card Header="{loc:SettingsLangResource Data}">
        <StackPanel Spacing="12">
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:SettingsLangResource RuleTransferHint}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <atom:Button HorizontalAlignment="Stretch" Command="{Binding ExportRulesCommand}" IsLoading="{Binding IsExportingRules}"
                         Content="{loc:SettingsLangResource ExportRules}" />
            <atom:Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{Binding ImportRulesCommand}"
                         Content="{loc:SettingsLangResource ImportRules}" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding RuleTransferStatus}"
                     IsVisible="{Binding RuleTransferStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </atom:Card>

      <atom:Card Header="{loc:SettingsLangResource About}">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock Classes="secondary" Text="{loc:SettingsLangResource Version}" />
            <TextBlock Grid.Column="1" Text="{x:Static vm:SettingsViewModel.Version}" TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock Classes="secondary" Text="{loc:SettingsLangResource Statistics}" />
            <TextBlock Grid.Column="1" Text="{Binding StatisticsText}" TextWrapping="Wrap" />
          </Grid>

          <TextBlock Classes="secondary" Margin="0,8,0,0" Text="{loc:SettingsLangResource Diagnostics}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{loc:SettingsLangResource DiagnosticsHint}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Center" Text="{loc:SettingsLangResource IncludeAppList}" />
            <atom:ToggleSwitch Grid.Column="1" IsChecked="{Binding IncludeAppList}" IsEnabled="{Binding !IsExporting}" />
          </Grid>
          <atom:Button HorizontalAlignment="Left" Command="{Binding ExportDiagnosticsCommand}" IsLoading="{Binding IsExporting}"
                       Content="{loc:SettingsLangResource ExportDiagnostics}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DiagnosticsStatus}"
                     IsVisible="{Binding DiagnosticsStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </atom:Card>
    </StackPanel>
    </ScrollViewer>

    <!-- 導入預覽：合併 / 覆寫，顯示增改刪數量和 Android 上不生效的規則 -->
    <Border Classes="scrim" IsVisible="{Binding IsImportDialogOpen}">
      <atom:Card VerticalAlignment="Bottom" Margin="12,12,12,24">
        <StackPanel Spacing="12">
          <TextBlock Classes="title" Text="{loc:SettingsLangResource ImportRules}" />
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding ImportSummary}" />
          <TextBlock Classes="warning" TextWrapping="Wrap" Text="{Binding ImportIneffective}"
                     IsVisible="{Binding ImportIneffective, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Spacing="6">
            <TextBlock Classes="secondary" Text="{loc:SettingsLangResource ImportMode}" />
            <atom:Segmented SelectedIndex="{Binding ImportModeIndex}" IsEnabled="{Binding !IsImportingRules}"
                            HorizontalAlignment="Stretch" IsExpanding="True">
              <atom:SegmentedItem Content="{loc:SettingsLangResource ImportMerge}" />
              <atom:SegmentedItem Content="{loc:SettingsLangResource ImportReplace}" />
            </atom:Segmented>
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <atom:Button HorizontalAlignment="Stretch" Command="{Binding CancelImportCommand}"
                         Content="{loc:CommonLangResource Cancel}" />
            <atom:Button Grid.Column="1" ButtonType="Primary" HorizontalAlignment="Stretch"
                         Command="{Binding ConfirmImportCommand}" IsLoading="{Binding IsImportingRules}"
                         Content="{loc:SettingsLangResource ImportApply}" />
          </Grid>
        </StackPanel>
      </atom:Card>
    </Border>
  </Grid>
</UserControl>
