<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:NetworkControl.App.ViewModels"
             xmlns:loc="using:NetworkControl.App.Localization"
             x:Class="NetworkControl.App.Views.OnboardingView"
             x:DataType="vm:OnboardingViewModel">
  <StackPanel Spacing="18" Margin="0,4,0,8">
    <TextBlock Classes="secondary" Text="{loc:OnboardingLangResource Intro}" TextWrapping="Wrap" />

    <!-- 三個要點：圖標 + 標題 + 說明 -->
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <Border Classes="onboarding-icon">
          <ContentControl Content="{antdicons:AntDesignIconProvider Kind=QuestionCircleOutlined}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Classes="rank-label" Text="{loc:OnboardingLangResource Step1Title}" />
          <TextBlock Classes="secondary" Text="{loc:OnboardingLangResource Step1Body}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <Border Classes="onboarding-icon">
          <ContentControl Content="{antdicons:AntDesignIconProvider Kind=DashboardOutlined}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Classes="rank-label" Text="{loc:OnboardingLangResource Step2Title}" />
          <TextBlock Classes="secondary" Text="{loc:OnboardingLangResource Step2Body}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <Border Classes="onboarding-icon">
          <ContentControl Content="{antdicons:AntDesignIconProvider Kind=SafetyCertificateOutlined}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Classes="rank-label" Text="{loc:OnboardingLangResource Step3Title}" />
          <TextBlock Classes="secondary" Text="{loc:OnboardingLangResource Step3Body}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <Border Classes="divider" />

    <!-- 初始模式 -->
    <StackPanel Spacing="10" IsVisible="{Binding IsConnected}">
      <TextBlock Classes="section-title" Text="{loc:OnboardingLangResource ChooseMode}" />
      <atom:Segmented SelectedIndex="{Binding ModeIndex}" HorizontalAlignment="Left">
        <atom:SegmentedItem Content="{Binding AskTitle}" />
        <atom:SegmentedItem Content="{loc:CommonLangResource ModeWhitelist}" />
        <atom:SegmentedItem Content="{loc:CommonLangResource ModeBlacklist}" />
      </atom:Segmented>
      <TextBlock Text="{Binding ModeDescription}" TextWrapping="Wrap" />
      <TextBlock Classes="caption" Text="{loc:OnboardingLangResource ModeLater}" TextWrapping="Wrap" />
    </StackPanel>
    <atom:Alert Type="Info" IsShowIcon="True" Message="{loc:OnboardingLangResource NotConnected}" IsVisible="{Binding !IsConnected}" />

    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsAutoStartSupported}">
      <atom:ToggleSwitch IsChecked="{Binding LaunchAtLogin}" />
      <TextBlock VerticalAlignment="Center" Text="{loc:SettingsLangResource LaunchAtLogin}" />
    </StackPanel>
  </StackPanel>
</UserControl>
