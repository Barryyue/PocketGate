<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:NetworkControl.App.ViewModels"
             x:Class="NetworkControl.App.Views.LogDetailView"
             x:DataType="vm:LogDetailViewModel">
  <StackPanel Spacing="14" Margin="0,4,0,8">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <atom:Tag Text="{Binding VerdictText}" TagColor="{Binding VerdictColor}" VerticalAlignment="Center" />
      <TextBlock Classes="section-title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Classes="secondary" Text="{Binding Explanation}" TextWrapping="Wrap" />
    <Border Classes="divider" />
    <ItemsControl ItemsSource="{Binding Fields}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DetailField">
          <Grid ColumnDefinitions="110,*" Margin="0,4">
            <TextBlock Classes="secondary" Text="{Binding Label}" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Classes.mono="{Binding Monospace}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
