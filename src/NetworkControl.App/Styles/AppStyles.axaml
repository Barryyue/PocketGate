<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net">
  <!-- 應用級樣式：只做排版層面的補充，顏色和尺寸一律引用 AtomUI 設計令牌，深淺色自動適配。 -->

  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeHeading4}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeLG}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextSecondary}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeSM}" />
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextTertiary}" />
  </Style>

  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeHeading3}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeSM}" />
  </Style>

  <Style Selector="TextBlock.metric.danger">
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorError}" />
  </Style>

  <Style Selector="TextBlock.danger-text">
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorError}" />
  </Style>

  <!-- 指標卡片的標題行 -->
  <Style Selector="TextBlock.kpi-caption">
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 圖例圓點：顏色與圖表一致（允許 = 主色，拒絕 = 錯誤色） -->
  <Style Selector="Ellipse.legend">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.legend.allowed">
    <Setter Property="Fill" Value="{atom:SharedTokenResource ColorPrimary}" />
  </Style>
  <Style Selector="Ellipse.legend.blocked">
    <Setter Property="Fill" Value="{atom:SharedTokenResource ColorError}" />
  </Style>

  <!-- 可點擊的列表行（排行榜等）：透明背景，懸停時淺色填充 -->
  <Style Selector="Button.rank-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="-10,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.rank-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{atom:SharedTokenResource ColorFillTertiary}" />
  </Style>
  <Style Selector="Button.rank-row:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{atom:SharedTokenResource ColorFillSecondary}" />
  </Style>
  <Style Selector="Button.rank-row:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="TextBlock.rank-label">
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.rank-count">
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextSecondary}" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!-- 引導頁的圓形圖標 -->
  <Style Selector="Border.onboarding-icon">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimaryBg}" />
  </Style>
  <Style Selector="Border.onboarding-icon > ContentControl">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.onboarding-icon atom|Icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorPrimary}" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{atom:SharedTokenResource ColorBorderSecondary}" />
  </Style>

  <!-- 主窗口佈局 -->
  <Style Selector="Border.sider">
    <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
    <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorderSecondary}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Border.content">
    <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgLayout}" />
  </Style>

  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
    <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorderSecondary}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,6" />
  </Style>

  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgElevated}" />
    <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorderSecondary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusLG}" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
</Styles>
