<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net">
  <!-- 手機界面的排版補充：顏色和尺寸一律引用 AtomUI 設計令牌，深淺色自動適配。 -->

  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeHeading3}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeLG}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextSecondary}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeSM}" />
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextTertiary}" />
  </Style>

  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeHeading3}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
  </Style>

  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorSuccess}" />
  </Style>

  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorWarning}" />
  </Style>

  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorError}" />
  </Style>

  <Style Selector="Border.page">
    <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgLayout}" />
  </Style>

  <!-- 懸浮膠囊底部導航（與 Kotlin 版 PocketGate 對齊） -->
  <Style Selector="Border.bottom-nav">
    <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgElevated}" />
    <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorderSecondary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Margin" Value="14,0,14,10" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="BackEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.bottom-nav.hidden">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransform" Value="translateY(110px) scale(0.92)" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextSecondary}" />
  </Style>

  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimaryBg}" />
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorPrimary}" />
  </Style>

  <Style Selector="Button.nav TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- 現代圓角列表卡片（與 Bento 卡片統一） -->
  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.plain ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
    <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorderSecondary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Margin" Value="14,4" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style Selector="Border.hero-badge">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimaryBg}" />
  </Style>

  <!-- 詢問覆蓋層 -->
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="#73000000" />
  </Style>
</Styles>
