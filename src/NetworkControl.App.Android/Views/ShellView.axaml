<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:NetworkControl.Android.ViewModels"
             xmlns:views="using:NetworkControl.Android.Views"
             xmlns:loc="using:NetworkControl.Android.Localization"
             x:Class="NetworkControl.Android.Views.ShellView"
             x:DataType="vm:MainViewModel">
  <Border Classes="page">
    <Panel>
      <!-- 全高邊到邊內容區：底部導覽列浮層疊加，隱藏時無空白佔位 -->
      <views:OverviewView DataContext="{Binding Overview}" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsOverview}" />
      <views:AppsView DataContext="{Binding Apps}" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsApps}" />
      <views:RulesView DataContext="{Binding Rules}" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsRules}" />
      <views:LogView DataContext="{Binding Log}" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsLog}" />
      <views:SettingsView DataContext="{Binding Settings}" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsSettings}" />

      <!-- 啟動中 / 啟動失敗 -->
      <Border Classes="page" IsVisible="{Binding IsLoading}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
          <atom:Spin IsSpinning="True" HorizontalAlignment="Center" />
          <TextBlock Classes="secondary" Text="{loc:ShellLangResource Starting}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Classes="page" IsVisible="{Binding StartError, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel VerticalAlignment="Center" Margin="24" Spacing="16">
          <atom:Alert Type="Error" IsShowIcon="True" Message="{Binding StartError}" />
          <atom:Button ButtonType="Primary" HorizontalAlignment="Center" Command="{Binding RetryCommand}" Content="{loc:CommonLangResource Retry}" />
        </StackPanel>
      </Border>

      <!-- 懸浮膠囊 5-Tab 底部導覽列（下滑自動隱藏、上滑靈動彈回） -->
      <Border Classes="bottom-nav"
              VerticalAlignment="Bottom"
              Classes.hidden="{Binding !BottomBarVisible}">
        <UniformGrid Columns="5">
          <Button Classes="nav" Classes.active="{Binding IsOverview}" Command="{Binding NavigateCommand}" CommandParameter="0">
            <StackPanel Spacing="2">
              <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=HomeOutlined}" Width="20" Height="20" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:ShellLangResource NavOverview}" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsApps}" Command="{Binding NavigateCommand}" CommandParameter="1">
            <StackPanel Spacing="2">
              <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}" Width="20" Height="20" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:ShellLangResource NavApps}" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsRules}" Command="{Binding NavigateCommand}" CommandParameter="2">
            <StackPanel Spacing="2">
              <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=SafetyOutlined}" Width="20" Height="20" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:ShellLangResource NavRules}" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsLog}" Command="{Binding NavigateCommand}" CommandParameter="3">
            <StackPanel Spacing="2">
              <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=StopOutlined}" Width="20" Height="20" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:ShellLangResource NavLog}" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsSettings}" Command="{Binding NavigateCommand}" CommandParameter="4">
            <StackPanel Spacing="2">
              <atom:IconPresenter Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}" Width="20" Height="20" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:ShellLangResource NavSettings}" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </Border>

      <!-- 詢問覆蓋層 -->
      <views:PromptOverlay DataContext="{Binding Prompt}"
                           IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Prompt.IsVisible, FallbackValue=False}" />

      <!-- 發現新版本自動提醒彈窗（直顯更新日誌） -->
      <Border Classes="scrim" IsVisible="{Binding ShowUpdateAvailableDialog}">
        <atom:Card VerticalAlignment="Center" Margin="20">
          <StackPanel Spacing="12">
            <TextBlock Classes="title" Text="{Binding UpdateAvailableTitle}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding UpdateAvailableBody}" />
            <ScrollViewer MaxHeight="200" IsVisible="{Binding HasUpdateReleaseNotes}">
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding UpdateReleaseNotes}" />
            </ScrollViewer>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <atom:Button HorizontalAlignment="Stretch" Command="{Binding DismissUpdateCommand}" Content="{loc:OverviewLangResource UpdateLater}" />
              <atom:Button Grid.Column="1" ButtonType="Primary" HorizontalAlignment="Stretch" Command="{Binding AcceptUpdateCommand}" Content="{loc:OverviewLangResource UpdateNow}" />
            </Grid>
          </StackPanel>
        </atom:Card>
      </Border>

      <!-- 下載完成提醒安裝彈窗 -->
      <Border Classes="scrim" IsVisible="{Binding ShowUpdateReadyDialog}">
        <atom:Card VerticalAlignment="Center" Margin="20">
          <StackPanel Spacing="12">
            <TextBlock Classes="title" Text="{Binding UpdateReadyTitle}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <atom:Button HorizontalAlignment="Stretch" Command="{Binding DismissUpdateReadyCommand}" Content="{loc:OverviewLangResource UpdateLater}" />
              <atom:Button Grid.Column="1" ButtonType="Primary" HorizontalAlignment="Stretch" Command="{Binding InstallUpdateNowCommand}" Content="{loc:OverviewLangResource UpdateInstallNow}" />
            </Grid>
          </StackPanel>
        </atom:Card>
      </Border>

      <!-- 首次啟動權限初始化引導彈窗 -->
      <Border Classes="scrim" IsVisible="{Binding ShowPermissionGuide}">
        <atom:Card VerticalAlignment="Center" Margin="18">
          <StackPanel Spacing="10">
            <TextBlock Classes="title" Text="{loc:SettingsLangResource PermissionHealth}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Text="{loc:SettingsLangResource Notifications}" />
              <atom:Button Grid.Column="1" Command="{Binding OpenPermNotificationsCommand}" Content="{loc:SettingsLangResource Open}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Text="{loc:SettingsLangResource AlwaysOn}" />
              <atom:Button Grid.Column="1" Command="{Binding OpenPermBatteryCommand}" Content="{loc:SettingsLangResource Open}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Text="{loc:ShellLangResource NavApps}" />
              <atom:Button Grid.Column="1" Command="{Binding OpenPermAppListCommand}" Content="{loc:SettingsLangResource Open}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Text="{loc:SettingsLangResource Traffic}" />
              <atom:Button Grid.Column="1" Command="{Binding OpenPermUsageCommand}" Content="{loc:SettingsLangResource Open}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Text="{loc:SettingsLangResource PromptOverlayEnabled}" />
              <atom:Button Grid.Column="1" Command="{Binding OpenPermOverlayCommand}" Content="{loc:SettingsLangResource Open}" />
            </Grid>
            <atom:Button ButtonType="Primary" HorizontalAlignment="Stretch" Command="{Binding DismissPermissionGuideCommand}" Content="{loc:OverviewLangResource Dismiss}" />
          </StackPanel>
        </atom:Card>
      </Border>
    </Panel>
  </Border>
</UserControl>
