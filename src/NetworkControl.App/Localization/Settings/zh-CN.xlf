    <unit id="SectionDiagnostics">
      <segment>
        <source>Diagnostics</source>
        <target state="translated">诊断</target>
      </segment>
    </unit>
    <unit id="DiagnosticsHint">
      <segment>
        <source>When something goes wrong, export a diagnostics package (zip) and send it to the developer. User names and the computer name are replaced; nothing is uploaded automatically.</source>
        <target state="translated">出现问题时导出诊断包（zip）发给开发者分析。用户名和计算机名会被替换，不会自动上传任何内容。</target>
      </segment>
    </unit>
    <unit id="DiagnosticsIncludeConfiguration">
      <segment>
        <source>Include rules and the app list (program paths, domains)</source>
        <target state="translated">包含规则和应用列表（程序路径、域名）</target>
      </segment>
    </unit>
    <unit id="DiagnosticsIncludeActivity">
      <segment>
        <source>Include the recent connection log (visited addresses and domains, last 7 days)</source>
        <target state="translated">包含最近的连接日志（访问过的地址和域名，最近 7 天）</target>
      </segment>
    </unit>
    <unit id="DiagnosticsExport">
      <segment>
        <source>Export diagnostics…</source>
        <target state="translated">导出诊断包…</target>
      </segment>
    </unit>
    <unit id="DiagnosticsOpenLogFolder">
      <segment>
        <source>Open log folder</source>
        <target state="translated">打开日志文件夹</target>
