<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows 引擎（M1）：用戶態 WFP（Windows Filtering Platform）。
    規則編譯為 WFP 過濾器下發；未知連接被默認阻斷過濾器攔下後，通過 WFP 網絡事件觸發詢問；
    域名規則依靠 ETW DNS-Client 事件把域名解析為 IP 過濾器。需要管理員 / SYSTEM 權限運行。
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkControl.Core\NetworkControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetworkControl.Engine.Windows.Tests" />
  </ItemGroup>
</Project>
