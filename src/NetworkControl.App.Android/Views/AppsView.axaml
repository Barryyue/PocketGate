<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:NetworkControl.Android.ViewModels"
             xmlns:loc="using:NetworkControl.Android.Localization"
             x:Class="NetworkControl.Android.Views.AppsView"
             x:DataType="vm:AppsViewModel">
  <Panel>
    <Grid RowDefinitions="Auto,*">
    <StackPanel Margin="16,16,16,8" Spacing="10">
      <TextBlock Classes="page-title" Text="{loc:ShellLangResource NavApps}" />
      <atom:LineEdit PlaceholderText="{loc:AppsLangResource Search}" Text="{Binding SearchText}"
                     LeftAddOn="{antdicons:AntDesignIconProvider Kind=SearchOutlined}" />
      <atom:Segmented SelectedIndex="{Binding FilterIndex}" HorizontalAlignment="Stretch" IsExpanding="True">
        <atom:SegmentedItem Content="{loc:AppsLangResource FilterAll}" />
        <atom:SegmentedItem Content="{loc:AppsLangResource FilterAllowed}" />
        <atom:SegmentedItem Content="{loc:AppsLangResource FilterBlocked}" />
        <atom:SegmentedItem Content="{loc:AppsLangResource FilterUnset}" />
        <atom:SegmentedItem Content="{loc:AppsLangResource System}" />
      </atom:Segmented>
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding CountText}" />
        <TextBlock Grid.Column="1" Classes="secondary" VerticalAlignment="Center" Text="{loc:AppsLangResource ShowSystem}" />
        <atom:ToggleSwitch Grid.Column="2" IsChecked="{Binding ShowSystem}" />
      </Grid>
    </StackPanel>

    <ListBox Grid.Row="1" Classes="plain" Padding="0,4,0,96" ItemsSource="{Binding Visible}" SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:AppItemViewModel">
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
              <Border Grid.RowSpan="2" Width="44" Height="44" CornerRadius="12" ClipToBounds="True" VerticalAlignment="Top"
                      Background="{atom:SharedTokenResource ColorFillTertiary}">
                <Image Width="44" Height="44" Source="{Binding Icon}" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="title" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" Text="{Binding PackageName}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="status-dot"
                          Classes.success="{Binding StatusKind, Converter={x:Static vm:Converters.IsEqual}, ConverterParameter=success}"
                          Classes.warning="{Binding StatusKind, Converter={x:Static vm:Converters.IsEqual}, ConverterParameter=warning}" />
                  <TextBlock FontSize="12" Classes.success="{Binding StatusKind, Converter={x:Static vm:Converters.IsEqual}, ConverterParameter=success}"
                             Classes.warning="{Binding StatusKind, Converter={x:Static vm:Converters.IsEqual}, ConverterParameter=warning}"
                             Classes.error="{Binding StatusKind, Converter={x:Static vm:Converters.IsEqual}, ConverterParameter=error}"
                             Text="{Binding StatusText}" />
                  <atom:Tag TagColor="red" Text="{loc:AppsLangResource Tampered}" IsVisible="{Binding IsTampered}" />
                  <atom:Tag Text="{loc:AppsLangResource System}" IsVisible="{Binding IsSystem}" />
                  <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding UsageText}" IsVisible="{Binding HasUsage}" />
                </StackPanel>
              </StackPanel>
              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <atom:Segmented HorizontalAlignment="Left" SizeType="Small"
                                SelectedIndex="{Binding DecisionIndex}" IsEnabled="{Binding !IsBusy}">
                  <atom:SegmentedItem Content="{loc:CommonLangResource Allow}" />
                  <atom:SegmentedItem Content="{loc:CommonLangResource Unset}" />
                  <atom:SegmentedItem Content="{loc:CommonLangResource Block}" />
                </atom:Segmented>
                <atom:Button Grid.Column="1" ButtonType="Link" Padding="4,0" Command="{Binding InspectCommand}" Content="{loc:AppsLangResource Details}" />
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="1" Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center"
               Text="{loc:AppsLangResource Empty}" IsVisible="{Binding IsEmpty}" />
    </Grid>

    <!-- 應用詳情彈窗（簽章指紋、信任發布者、今日用量與最近目標） -->
    <Border Classes="scrim" IsVisible="{Binding HasDetailApp}">
      <atom:Card VerticalAlignment="Center" Margin="18" Header="{Binding DetailApp.Label, FallbackValue=''}">
        <StackPanel Spacing="10">
          <TextBlock Classes="caption" Text="{Binding DetailApp.PackageName, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock Classes="secondary" Text="{Binding DetailApp.UsageText, FallbackValue=''}" IsVisible="{Binding DetailApp.HasUsage, FallbackValue=False}" />
          <StackPanel Spacing="4" IsVisible="{Binding DetailSignerSha256, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Classes="caption" Text="{loc:AppsLangResource PublisherHash}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Text="{Binding DetailSignerSha256}" />
              <atom:Button Grid.Column="1" SizeType="Small" IsVisible="{Binding !IsDetailPublisherTrusted}"
                           Command="{Binding TrustDetailPublisherCommand}" Content="{loc:AppsLangResource TrustPublisher}" />
              <atom:Tag Grid.Column="1" TagColor="green" IsVisible="{Binding IsDetailPublisherTrusted}" Text="{loc:AppsLangResource Trusted}" />
            </Grid>
          </StackPanel>
          <TextBlock Classes="secondary" Text="{loc:AppsLangResource RecentTargets}" />
          <ScrollViewer MaxHeight="160">
            <ItemsControl ItemsSource="{Binding DetailRecentTargets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="caption" Text="{Binding}" Margin="0,2" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <atom:Button HorizontalAlignment="Stretch" Command="{Binding CloseDetailCommand}" Content="{loc:CommonLangResource Cancel}" />
        </StackPanel>
      </atom:Card>
    </Border>
  </Panel>
</UserControl>
