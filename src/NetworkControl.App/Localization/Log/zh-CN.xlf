    <unit id="ExplainMode">
      <segment>
        <source>No rule matched, so the current filter mode decided.</source>
        <target state="translated">没有规则命中，由当前过滤模式决定。</target>
      </segment>
    </unit>
    <unit id="ExplainPrompt">
      <segment>
