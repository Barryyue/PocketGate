<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:NetworkControl.App.ViewModels"
             xmlns:loc="using:NetworkControl.App.Localization"
             x:Class="NetworkControl.App.Views.ProfileEditorView"
             x:DataType="vm:ProfileEditorViewModel">

  <UserControl.Resources>
    <DataTemplate x:Key="ChoiceTemplate" x:DataType="vm:Choice">
      <TextBlock Text="{Binding Title}" />
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="14" Margin="0,8,0,0">
    <atom:Alert Type="Error" IsShowIcon="True" Message="{Binding ValidationError}"
                IsVisible="{Binding ValidationError, Converter={x:Static vm:Converters.HasText}}" />

    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
      <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{loc:ProfilesLangResource NameLabel}" />
      <atom:LineEdit Grid.Row="0" Grid.Column="1" Text="{Binding Name}"
                     PlaceholderText="{loc:ProfilesLangResource NamePlaceholder}" />

      <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{loc:ProfilesLangResource ModeLabel}" />
      <atom:ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                     ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" ItemTemplate="{StaticResource ChoiceTemplate}" />

      <TextBlock Grid.Row="2" VerticalAlignment="Center" IsVisible="{Binding CanCopy}"
                 Text="{loc:ProfilesLangResource CopyRulesLabel}" />
      <atom:ComboBox Grid.Row="2" Grid.Column="1" IsVisible="{Binding CanCopy}" HorizontalAlignment="Stretch"
                     ItemsSource="{Binding CopySources}" SelectedItem="{Binding SelectedCopySource}" ItemTemplate="{StaticResource ChoiceTemplate}" />
    </Grid>
  </StackPanel>
</UserControl>
