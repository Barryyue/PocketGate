        <target state="translated">匯出診斷包…</target>
      </segment>
    </unit>
    <unit id="DiagnosticsOpenLogFolder">
      <segment>
        <source>Open log folder</source>
        <target state="translated">開啟記錄資料夾</target>
      </segment>
    </unit>
    <unit id="DiagnosticsPickerTitle">
