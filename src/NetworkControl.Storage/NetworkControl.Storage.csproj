<Project Sdk="Microsoft.NET.Sdk">
  <!-- SQLite 存儲：config.db（規則、應用、設置）與 activity.db（日誌、統計）。 -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkControl.Core\NetworkControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetworkControl.Storage.Tests" />
  </ItemGroup>
</Project>
