<Project>
  <!-- 所有項目共享的編譯設置 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 質量門檻：警告即錯誤，啟用最新的代碼分析規則 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- 配置綁定改用源生成器：AOT / 裁剪安全 -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <Product>NetworkControl</Product>
    <Company>NetworkControl</Company>
    <Copyright>Copyright © NetworkControl contributors</Copyright>
    <VersionPrefix>0.3.0</VersionPrefix>
    <!-- 更新清單地址（latest.json）：留空時界面中不顯示更新功能。正式發布源確定後填入，例如 https://example.com/networkcontrol/latest.json -->
    <UpdateFeedUrl></UpdateFeedUrl>
    <NeutralLanguage>zh-Hant</NeutralLanguage>

    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <!--
    Native AOT 會把運行時（包括 Brotli 解碼器等）靜態鏈接進可執行文件，發布時必須使用已修復安全漏洞的版本：
    SDK 10.0.402 自帶的 10.0.13 受 CVE-2026-111497（GHSA-p3jp-9v83-76w9，修復於 10.0.14）影響。
    只在 AOT 發布時生效（發布腳本以全局屬性傳入 PublishAot），不影響本機用已安裝運行時進行的日常構建和運行。
    升級 SDK 或出現新的運行時安全更新時同步修改。
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 測試代碼放寬部分命名和分析規則 -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007</NoWarn>
  </PropertyGroup>
</Project>
